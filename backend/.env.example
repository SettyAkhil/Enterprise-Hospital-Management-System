DATABASE_URL=postgresql://hospai_er_app:CHANGE_ME@localhost:5432/hospai_er_dev
DEFAULT_HOSPITAL_CODE=hosp-default
SESSION_COOKIE_NAME=hospai_er_session
SESSION_TTL_HOURS=12
SESSION_PEPPER=change-me-dev-only

# Optional: OpenAI/vLLM-compatible endpoint for AI-assisted triage suggestions
# in POST /api/symptom-ai/triage. When unset, that endpoint gracefully falls
# back to a non-AI suggestion instead of failing -- the rest of the ER
# workflow (manual triage, doctor assignment, disposition, bed requests)
# works fully without this.
VLLM_BASE_URL=
VLLM_MODEL=
VLLM_API_KEY=
